# ============================================================
# Security Headers — FN Security
# FEL-54 — implementado via public/_headers (Cloudflare Pages)
# Revisão: 2026-08-13
# ============================================================

/*
  # ── HSTS ───────────────────────────────────────────────────
  # Conservador: sem includeSubDomains (subdomínios não mapeados)
  # Sem preload nesta etapa
  # max-age = 6 meses → escalonar para 1 ano após validação
  Strict-Transport-Security: max-age=15768000

  # ── Content-Type Sniffing ───────────────────────────────────
  X-Content-Type-Options: nosniff

  # ── Referrer Policy ────────────────────────────────────────
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Frame Protection ────────────────────────────────────────
  # frame-ancestors na CSP abaixo é a diretiva moderna
  # X-Frame-Options mantido para compatibilidade com browsers antigos
  X-Frame-Options: DENY

  # ── Permissions Policy ─────────────────────────────────────
  # Site não utiliza câmera, microfone, geolocalização, pagamento,
  # USB, sensores de movimento ou outras APIs sensíveis
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()

  # ── CORS ───────────────────────────────────────────────────
  # Cloudflare Pages adiciona Access-Control-Allow-Origin: * por padrão
  # em todos os assets estáticos (comportamento built-in da plataforma).
  # Para um site institucional público, sem API, sem sessões e sem
  # endpoints sensíveis, o risco real é mínimo. No entanto, o wildcard
  # CORS é desnecessário: o site não precisa ser carregado cross-origin
  # por terceiros. Removido explicitamente para reduzir superfície e
  # eliminar o finding ZAP-02 (Low).
  # A notação "! Header" remove o header padrão do Cloudflare Pages.
  ! Access-Control-Allow-Origin

  # ── Content Security Policy ─────────────────────────────────
  # Construída a partir do inventário real do site (FEL-39, fase 2):
  #
  # default-src: apenas self — sem fallback amplo
  # script-src:
  #   - 'self' para scripts estáticos servidos pelo Cloudflare Pages
  #   - hashes SHA-256 dos dois scripts inline compilados pelo Astro:
  #     · bsPNaTZfGp92... → Header menu mobile (hambúrguer)
  #     · aKcCPqIRXrtC... → Footer ano dinâmico
  #   - JSON-LD (type=application/ld+json) NÃO é executado como script
  #     e não requer hash em script-src
  # style-src:
  #   - 'self' para CSS gerado pelo Astro
  #   - 'unsafe-inline' necessário: Astro injeta estilos críticos inline
  #     no <style> de cada componente (design system atual)
  #     Dívida técnica: externalizar CSS crítico em v2 permite remover unsafe-inline
  # img-src:
  #   - 'self' para todos os ativos locais (imagens, favicon, SVG)
  #   - data: necessário para favicon.svg inlinado pelo browser em alguns contextos
  # font-src:
  #   - 'self' — sem fontes externas (system fonts e CSS local)
  # connect-src:
  #   - 'self' — sem chamadas fetch/XHR externas (links LinkedIn/WhatsApp são <a>, não fetch)
  # frame-src: 'none' — sem iframes
  # object-src: 'none' — sem plugins legados
  # base-uri: 'self' — previne base tag injection
  # form-action: 'self' — sem formulários externos (site sem forms atualmente)
  # frame-ancestors: 'none' — previne clickjacking
  # upgrade-insecure-requests — força HTTPS em recursos mistos
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-bsPNaTZfGp92iofzuFHoL+XcAoX+4BpbPXTFq+4COug=' 'sha256-aKcCPqIRXrtCSln46EXxOr1UBfs+emnVCz9G9XFG7OE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

  # ── Cache ───────────────────────────────────────────────────
  # Assets estáticos com hash no nome (/_astro/*): cache longo
  # HTML e _headers: no-cache para receber atualizações imediatas

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=86400

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
