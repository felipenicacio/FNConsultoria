---
import type { Service } from '../data/services';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

{services.length > 0 && (
  <section class="related section" aria-labelledby="related-title">
    <div class="container">
      <p class="eyebrow">Serviços relacionados</p>
      <h2 id="related-title">Outros serviços que podem complementar esta atuação</h2>
      <ul class="related-grid" role="list">
        {services.map((service) => (
          <li>
            <a class="related-card" href={`/servicos/${service.slug}`}>
              <span class="related-layer">
                {service.layer === 'primary'
                  ? 'Principal'
                  : service.layer === 'transversal'
                  ? 'Transversal'
                  : 'Especializado'}
              </span>
              <strong class="related-title">{service.shortTitle}</strong>
              <p class="related-desc">{service.description}</p>
              <span class="related-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .related { background: var(--slate-100); }
  .related h2 { font-size: clamp(1.7rem, 3vw, 2.8rem); margin-bottom: 2.5rem; }

  .related-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: .6rem;
    padding: 1.6rem 1.8rem;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-md);
    background: var(--white);
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  .related-card:hover {
    border-color: var(--blue-600);
    box-shadow: 0 8px 32px rgba(23,105,224,.08);
    transform: translateY(-2px);
  }

  .related-layer {
    color: var(--blue-600);
    font-size: .67rem;
    font-weight: 850;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .related-title { display: block; color: var(--navy-950); font-size: 1.05rem; line-height: 1.3; }
  .related-desc { margin: 0; color: var(--slate-700); font-size: .88rem; line-height: 1.55; flex: 1; }
  .related-arrow { color: var(--teal-500); font-weight: 900; margin-top: .4rem; }
</style>
