<header class="site-header">
  <div class="container nav">
    <a class="brand" href="#inicio" aria-label="FN Consulting - Início"><strong>FN</strong><span>Consulting</span></a>
    <div class="nav-right">
      <nav aria-label="Navegação principal">
        <div id="primary-nav-links" class="nav-links">
          <a href="#servicos">Serviços</a>
          <a href="#metodologia">Metodologia</a>
          <a href="#referencias">Referências</a>
          <a href="#sobre">Sobre</a>
        </div>
        <a class="nav-cta" href="#contato">Fale conosco</a>
      </nav>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="primary-nav-links"
        aria-label="Abrir menu"
      >
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(226,232,240,.86); }
  .nav { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: baseline; gap: .42rem; letter-spacing: -.04em; }
  .brand strong { color: var(--navy-950); font-size: 1.3rem; font-weight: 900; }
  .brand span { color: var(--slate-500); font-size: 1rem; font-weight: 650; letter-spacing: -.02em; }
  .nav-right { display: flex; align-items: center; }
  nav { display: flex; align-items: center; gap: 1.4rem; font-size: .9rem; font-weight: 700; color: var(--slate-700); }
  .nav-links { display: contents; }
  nav a { transition: color .2s ease, background-color .2s ease; }
  nav a:hover { color: var(--blue-600); }
  .nav-cta { padding: .62rem 1rem; border-radius: 999px; background: var(--navy-950); color: white; }
  .nav-cta:hover { color: white; background: var(--blue-600); }
  .nav-toggle { display: none; }

  @media (max-width: 760px) {
    .nav { min-height: 68px; }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      padding: 0;
      margin-left: .9rem;
      border: 1px solid var(--slate-200);
      border-radius: 10px;
      background: var(--white);
      cursor: pointer;
    }
    .nav-toggle span { position: relative; display: block; width: 18px; height: 2px; background: var(--navy-950); }
    .nav-toggle span::before,
    .nav-toggle span::after { content: ""; position: absolute; left: 0; width: 18px; height: 2px; background: var(--navy-950); transition: transform .2s ease, top .2s ease; }
    .nav-toggle span::before { top: -6px; }
    .nav-toggle span::after { top: 6px; }
    .nav-toggle[aria-expanded="true"] span { background: transparent; }
    .nav-toggle[aria-expanded="true"] span::before { top: 0; transform: rotate(45deg); }
    .nav-toggle[aria-expanded="true"] span::after { top: 0; transform: rotate(-45deg); }

    .nav-links {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 1px solid var(--slate-200);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transition: max-height .25s ease, opacity .2s ease, visibility 0s linear .25s;
    }
    .nav-links a { padding: .85rem 1.25rem; }
    .nav-links.is-open { max-height: 320px; opacity: 1; visibility: visible; padding-block: .5rem; transition: max-height .25s ease, opacity .2s ease; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.getElementById('primary-nav-links');

  if (toggle && links) {
    const setOpen = (open: boolean) => {
      links.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    };

    toggle.addEventListener('click', () => {
      setOpen(!links.classList.contains('is-open'));
    });

    links.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && links.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
