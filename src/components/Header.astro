<!--
  Header — experimento visual hero-layout-referencia-v1
  Referência: imagem aprovada por Felipe Nicácio (12/08/2026)
  Logo maior à esquerda, menu horizontal à direita com CTA pill navy.
  Nota: item "Conteúdo" omitido — sem âncora real no projeto.
-->
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="#inicio" aria-label="FN Security — Página inicial">
      <picture>
        <source srcset="/images/fn-security-logo-blue.webp" type="image/webp" width="110" height="75" />
        <img
          src="/images/fn-security-logo-blue.png"
          alt="FN Security"
          width="110"
          height="75"
          loading="eager"
          decoding="auto"
          class="brand-logo"
        />
      </picture>
    </a>

    <div class="nav-right">
      <nav aria-label="Navegação principal">
        <div id="primary-nav-links" class="nav-links">
          <a href="#servicos">Serviços</a>
          <a href="#como-atuamos">Método</a>
          <a href="#sobre">Quem Somos</a>
          <a href="#contato">Contato</a>
        </div>
        <a class="nav-cta" href="#contato">Fale conosco</a>
      </nav>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="primary-nav-links"
        aria-label="Abrir menu"
      >
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255,255,255,.97);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(226,232,240,.7);
    box-shadow: 0 1px 12px rgba(0,0,0,.04);
  }

  .nav {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Logo maior conforme referência */
  .brand { display: inline-flex; align-items: center; flex-shrink: 0; }
  .brand-logo { display: block; width: 110px; height: 75px; object-fit: contain; }

  .nav-right { display: flex; align-items: center; }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.2vw, 2.2rem);
    font-size: .95rem;
    font-weight: 600;
    color: #334155;
  }

  .nav-links { display: contents; }
  nav a { transition: color .2s ease; white-space: nowrap; }
  nav a:hover { color: var(--blue-600); }

  .nav-cta {
    padding: .72rem 1.4rem;
    border-radius: 999px;
    background: var(--navy-950);
    color: white;
    font-weight: 700;
    white-space: nowrap;
    transition: background .2s ease;
  }
  .nav-cta:hover { background: var(--blue-600); color: white; }

  .nav-toggle { display: none; }

  /* ── Mobile ── */
  @media (max-width: 820px) {
    .nav { min-height: 72px; }
    .brand-logo { width: 88px; height: 60px; }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      margin-left: .9rem;
      border: 1px solid var(--slate-200);
      border-radius: 10px;
      background: var(--white);
      cursor: pointer;
    }
    .nav-toggle span { position: relative; display: block; width: 18px; height: 2px; background: var(--navy-950); }
    .nav-toggle span::before,
    .nav-toggle span::after { content: ""; position: absolute; left: 0; width: 18px; height: 2px; background: var(--navy-950); transition: transform .2s ease, top .2s ease; }
    .nav-toggle span::before { top: -6px; }
    .nav-toggle span::after { top: 6px; }
    .nav-toggle[aria-expanded="true"] span { background: transparent; }
    .nav-toggle[aria-expanded="true"] span::before { top: 0; transform: rotate(45deg); }
    .nav-toggle[aria-expanded="true"] span::after { top: 0; transform: rotate(-45deg); }

    .nav-links {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 1px solid var(--slate-200);
      box-shadow: 0 8px 24px rgba(0,0,0,.08);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transition: max-height .25s ease, opacity .2s ease, visibility 0s linear .25s;
    }
    .nav-links a { padding: .95rem 1.5rem; font-size: 1rem; border-bottom: 1px solid var(--slate-100); }
    .nav-links.is-open { max-height: 360px; opacity: 1; visibility: visible; padding-block: .4rem; transition: max-height .25s ease, opacity .2s ease; }

    /* CTA escondido em mobile no nav horizontal — aparece no menu */
    .nav-cta { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.getElementById('primary-nav-links');

  if (toggle && links) {
    const setOpen = (open: boolean) => {
      links.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    };

    toggle.addEventListener('click', () => {
      setOpen(!links.classList.contains('is-open'));
    });

    links.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && links.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
