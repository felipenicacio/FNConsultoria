<!-- Header — FEL-51: marca V1 integrada ao fundo claro, sem bloco escuro. -->
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="#inicio" aria-label="FN Security — Página inicial">
      <img
        src="/images/fn-security-logo-light.svg"
        alt="FN Security"
        width="144"
        height="60"
        loading="eager"
        decoding="async"
        class="brand-logo"
      />
    </a>
    <div class="nav-right">
      <nav aria-label="Navegação principal">
        <div id="primary-nav-links" class="nav-links">
          <a href="#servicos">Serviços</a>
          <a href="#como-atuamos">Como atuamos</a>
          <a href="#referencias">Referências</a>
          <a href="#sobre">Sobre</a>
        </div>
        <a class="nav-cta" href="#contato">Fale conosco</a>
      </nav>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav-links" aria-label="Abrir menu"><span></span></button>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.96); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(226,232,240,.8); box-shadow: 0 8px 30px rgba(7,17,31,.035); }
  .nav { min-height: 86px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; flex-shrink: 0; }
  .brand-logo { display: block; width: 144px; height: 60px; object-fit: contain; }
  .nav-right { display: flex; align-items: center; }
  nav { display: flex; align-items: center; gap: 1.65rem; font-size: .9rem; font-weight: 750; color: var(--navy-950); }
  .nav-links { display: contents; }
  nav a { transition: color .2s ease, background-color .2s ease, transform .2s ease; }
  nav a:hover { color: var(--blue-600); }
  .nav-cta { padding: .72rem 1.2rem; border-radius: 999px; background: var(--navy-950); color: white; box-shadow: 0 8px 20px rgba(7,17,31,.12); }
  .nav-cta:hover { color: white; background: var(--blue-600); transform: translateY(-1px); }
  .nav-toggle { display: none; }

  @media (max-width: 760px) {
    .nav { min-height: 76px; }
    .brand-logo { width: 124px; height: 52px; }
    .nav-cta { display: none; }
    .nav-toggle { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; padding: 0; margin-left: .9rem; border: 0; border-radius: 10px; background: var(--white); cursor: pointer; }
    .nav-toggle span { position: relative; display: block; width: 21px; height: 2px; background: var(--navy-950); }
    .nav-toggle span::before, .nav-toggle span::after { content: ""; position: absolute; left: 0; width: 21px; height: 2px; background: var(--navy-950); transition: transform .2s ease, top .2s ease; }
    .nav-toggle span::before { top: -7px; }
    .nav-toggle span::after { top: 7px; }
    .nav-toggle[aria-expanded="true"] span { background: transparent; }
    .nav-toggle[aria-expanded="true"] span::before { top: 0; transform: rotate(45deg); }
    .nav-toggle[aria-expanded="true"] span::after { top: 0; transform: rotate(-45deg); }
    .nav-links { display: flex; flex-direction: column; position: absolute; top: 100%; left: 0; right: 0; background: var(--white); border-bottom: 1px solid var(--slate-200); box-shadow: 0 18px 34px rgba(7,17,31,.08); max-height: 0; overflow: hidden; opacity: 0; visibility: hidden; transition: max-height .25s ease, opacity .2s ease, visibility 0s linear .25s; }
    .nav-links a { padding: .9rem 1.25rem; }
    .nav-links.is-open { max-height: 320px; opacity: 1; visibility: visible; padding-block: .55rem; transition: max-height .25s ease, opacity .2s ease; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.getElementById('primary-nav-links');
  if (toggle && links) {
    const setOpen = (open: boolean) => {
      links.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    };
    toggle.addEventListener('click', () => setOpen(!links.classList.contains('is-open')));
    links.addEventListener('click', (event) => { if (event.target instanceof HTMLAnchorElement) setOpen(false); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && links.classList.contains('is-open')) { setOpen(false); toggle.focus(); } });
  }
</script>
