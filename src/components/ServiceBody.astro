---
/**
 * Corpo da página de serviço.
 *
 * Exibe os dados aprovados no Notion via services.ts:
 *   - Quando contratar (whenToHire)
 *   - Referências metodológicas (references)
 *   - CTA genérico de contato
 *
 * Conteúdo adicional — escopo completo, etapas, entregáveis e CTA
 * específico por serviço — será adicionado na Fase 5 após aprovação
 * do design e do conteúdo editorial definitivo.
 */
import type { Service } from '../data/services';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<div class="service-body">

  <!-- Quando contratar -->
  {service.whenToHire && service.whenToHire.length > 0 && (
    <section class="when-section section" aria-labelledby="quando-title">
      <div class="container when-grid">
        <div class="when-heading">
          <p class="eyebrow">Quando contratar</p>
          <h2 id="quando-title">Este serviço é indicado quando</h2>
        </div>
        <ol class="when-list" aria-label="Contextos de contratação">
          {service.whenToHire.map((item, i) => (
            <li>
              <span class="when-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- Referências metodológicas -->
  {service.references && service.references.length > 0 && (
    <section class="references-section section" aria-labelledby="referencias-title">
      <div class="container">
        <p class="eyebrow">Referências metodológicas</p>
        <h2 id="referencias-title">Normas e frameworks utilizados</h2>
        <p class="lead ref-lead">
          A atuação da FN Security utiliza normas e frameworks reconhecidos
          internacionalmente como instrumentos de estruturação e referência,
          não como fins em si mesmos.
        </p>
        <ul class="ref-tags" aria-label="Normas e frameworks deste serviço">
          {service.references.map((ref) => (
            <li><span>{ref}</span></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- CTA de contato -->
  <section class="cta-section section">
    <div class="container">
      <div class="cta-box">
        <div class="cta-content">
          <p class="eyebrow">Próximo passo</p>
          <h2>Quer entender como este serviço se aplica à sua organização?</h2>
          <p class="lead">
            Uma conversa inicial ajuda a definir contexto, necessidade e
            abordagem mais adequada para a sua realidade.
          </p>
        </div>
        <div class="cta-action">
          <a
            class="button button-primary"
            href="https://www.linkedin.com/in/felipe-nicacio/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Fale pelo LinkedIn
            <span class="sr-only"> (abre em nova aba)</span>
          </a>
          <a class="back-link" href="/#servicos">
            <span aria-hidden="true">←</span> Ver todos os serviços
          </a>
        </div>
      </div>
    </div>
  </section>

</div>

<style>
  /* Quando contratar */
  .when-section { background: var(--white); }

  .when-grid {
    display: grid;
    grid-template-columns: .75fr 1.25fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .when-heading { position: sticky; top: 110px; }
  .when-heading h2 { font-size: clamp(1.8rem, 3.5vw, 3rem); }

  .when-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .when-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--slate-200);
  }
  .when-list li:first-child { border-top: 1px solid var(--slate-200); }

  .when-index {
    color: var(--blue-600);
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .12em;
    padding-top: .18rem;
  }

  .when-list p {
    margin: 0;
    color: var(--navy-900);
    font-size: 1rem;
    line-height: 1.6;
    font-weight: 500;
  }

  /* Referências */
  .references-section { background: var(--slate-100); }
  .references-section h2 { font-size: clamp(1.8rem, 3.5vw, 3rem); }
  .ref-lead { max-width: 64ch; }

  .ref-tags {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
  }
  .ref-tags li span {
    display: inline-block;
    padding: .72rem .95rem;
    border: 1px solid var(--slate-200);
    border-radius: 999px;
    color: var(--navy-900);
    background: var(--white);
    font-size: .86rem;
    font-weight: 700;
  }

  /* CTA */
  .cta-section { background: var(--white); }

  .cta-box {
    display: grid;
    grid-template-columns: 1.3fr .7fr;
    gap: 4rem;
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4rem);
    border-radius: var(--radius-xl);
    background: var(--navy-950);
    color: white;
    position: relative;
    overflow: hidden;
  }
  .cta-box::before {
    content: "";
    position: absolute;
    width: 320px; height: 320px;
    right: -100px; bottom: -160px;
    border: 1px solid rgba(125,211,252,.12);
    border-radius: 50%;
    box-shadow: 0 0 0 60px rgba(23,105,224,.025);
  }
  .cta-content, .cta-action { position: relative; z-index: 1; }
  .cta-box .eyebrow { color: #7dd3fc; }
  .cta-box h2 { color: white; font-size: clamp(1.6rem, 3vw, 2.5rem); max-width: 22ch; }
  .cta-box .lead { color: #cbd5e1; }

  .cta-action {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .back-link {
    color: #94a3b8;
    font-size: .88rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: .4rem;
    transition: color .2s ease;
  }
  .back-link:hover { color: white; }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .when-heading { position: static; }
  }
  @media (max-width: 760px) {
    .cta-box { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
