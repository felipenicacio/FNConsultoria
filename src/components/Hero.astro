<!--
  Hero — experimento visual hero-layout-referencia-v1
  Referência: imagem aprovada por Felipe Nicácio (12/08/2026)
  Fundo branco, duas colunas (texto 46% | escudo 54%), eyebrow azul,
  H1 preservado, copy preservado, CTAs pill navy + secundário seta.
-->
<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">

    <!-- Coluna esquerda — texto -->
    <div class="hero-content">
      <p class="eyebrow" aria-label="Consultoria especializada">CONSULTORIA ESPECIALIZADA</p>
      <h1 id="hero-title">Segurança da Informação orientada por riscos e prioridades do negócio.</h1>
      <p class="hero-copy">A FN Security apoia organizações a estruturar e evoluir sua Segurança da Informação conectando riscos, prioridades, capacidades e decisões às necessidades reais do negócio.</p>
      <div class="actions">
        <a class="cta-primary" href="#contato">Fale conosco</a>
        <a class="cta-secondary" href="#servicos">
          Nossos serviços
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Coluna direita — escudo tecnológico -->
    <div class="hero-visual" aria-hidden="true">
      <!-- Rede digital de fundo -->
      <div class="digital-network">
