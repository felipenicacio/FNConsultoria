      </div>

      <!-- Escudo principal -->
      <div class="shield-wrap">
        <img
          src="/images/hero-shield.svg"
          alt=""
          class="shield-img"
          width="480"
          height="530"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Hero base ── */
  .hero {
    position: relative;
    background: #ffffff;
    overflow: hidden;
    padding: 4.5rem 0 3.5rem;
  }

  /* Gradiente muito suave de fundo */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 75% 50%, rgba(30,95,168,.06), transparent),
      radial-gradient(ellipse 40% 40% at 20% 60%, rgba(42,106,191,.04), transparent);
    pointer-events: none;
  }

  /* ── Grid bicoluna ── */
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 46fr 54fr;
    gap: clamp(3rem, 5vw, 5rem);
    align-items: center;
    min-height: 520px;
  }

  /* ── Conteúdo textual ── */
  .hero-content { display: flex; flex-direction: column; gap: 0; }

  .eyebrow {
    display: inline-block;
    color: var(--blue-600);
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    margin: 0 0 1.1rem;
  }

  .hero h1 {
    color: var(--navy-950);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0 0 1.4rem;
    max-width: 16ch;
  }

  .hero-copy {
    color: #475569;
    font-size: clamp(.95rem, 1.4vw, 1.08rem);
    line-height: 1.7;
    max-width: 46ch;
    margin: 0 0 2.2rem;
  }

  /* ── CTAs ── */
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .85rem 1.8rem;
    border-radius: 999px;
    background: var(--navy-950);
    color: white;
    font-size: .95rem;
    font-weight: 700;
    letter-spacing: .01em;
    transition: background .2s ease, transform .15s ease;
    white-space: nowrap;
  }
  .cta-primary:hover { background: var(--blue-600); transform: translateY(-1px); }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: var(--navy-950);
    font-size: .95rem;
    font-weight: 700;
    transition: color .2s ease, gap .2s ease;
    white-space: nowrap;
  }
  .cta-secondary:hover { color: var(--blue-600); gap: .65rem; }
  .cta-secondary svg { flex-shrink: 0; }

  /* ── Visual — escudo + rede digital ── */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 480px;
  }

  /* Rede digital — fundo do visual */
  .digital-network {
    position: absolute;
    inset: -40px -20px;
    overflow: hidden;
    pointer-events: none;
  }
  .network-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Escudo */
  .shield-wrap {
    position: relative;
    z-index: 1;
    width: 85%;
    max-width: 460px;
    filter: drop-shadow(0 20px 60px rgba(14,50,120,.18)) drop-shadow(0 4px 16px rgba(14,50,120,.12));
  }
  .shield-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Responsividade ── */
  @media (max-width: 900px) {
    .hero { padding: 3.5rem 0 2.5rem; }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      min-height: auto;
    }
    .hero h1 { max-width: 100%; }
    .hero-copy { max-width: 58ch; }
    .hero-visual { min-height: 320px; }
    .shield-wrap { width: 70%; max-width: 340px; margin: 0 auto; }
  }

  @media (max-width: 540px) {
    .hero { padding: 2.5rem 0 2rem; }
    .hero h1 { font-size: clamp(1.9rem, 8vw, 2.6rem); }
    .shield-wrap { width: 80%; max-width: 280px; }
    .hero-visual { min-height: 260px; }
    .cta-primary, .cta-secondary { font-size: .9rem; }
    .actions { gap: .8rem; }
  }
</style>
