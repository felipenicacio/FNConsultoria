---
/**
 * Seção de serviços — Home.
 *
 * GOVERNANÇA
 * ──────────────────────────────────────────────────────────────────────────
 * Destaque visual definitivo, ordenação final e textos dos cards dependem
 * da conclusão das FEL-19 a FEL-24. Este componente usa os dados de
 * services.ts e respeita a separação por camada aprovada na FEL-18:
 *   - primary       → grid principal
 *   - complementary → bloco secundário
 *   - transversal   → não exposta como card nesta seção
 *
 * Nenhum card tem destaque visual fixo até a FEL-24 ser concluída.
 */
import { primaryServices, complementaryServices } from '../data/services';
---

<section id="servicos" class="section services-section" aria-labelledby="servicos-title">
  <div class="container">

    <div class="section-header services-header">
      <div>
        <p class="eyebrow">Serviços</p>
        <h2 id="servicos-title">Da avaliação do cenário atual à construção de capacidades sustentáveis.</h2>
      </div>
      <p class="lead">
        Serviços estruturados para apoiar decisões, organizar prioridades e desenvolver
        a Segurança da Informação como capacidade de gestão.
      </p>
    </div>

    <div class="services-grid" aria-label="Serviços principais">
      {primaryServices.map((service) => (
        <article class="service-card">
          <div class="service-meta">
            <span class="service-layer">Principal</span>
            <span class="line" aria-hidden="true"></span>
          </div>
          <h3>
            <a href={`/servicos/${service.slug}`}>{service.title}</a>
          </h3>
          <p class="description">{service.description}</p>
          <div class="outcome-wrap">
            <span>Resultado esperado</span>
            <p class="outcome">{service.outcome}</p>
          </div>
          <a
            class="service-link"
            href={`/servicos/${service.slug}`}
            aria-label={`Saiba mais sobre ${service.shortTitle}`}
          >
            Saiba mais <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    {complementaryServices.length > 0 && (
      <div class="complementary-block">
        <p class="complementary-label">Serviços complementares e especializados</p>
        <ul class="complementary-grid" role="list">
          {complementaryServices.map((service) => (
            <li>
              <a class="complementary-card" href={`/servicos/${service.slug}`}>
                <strong>{service.shortTitle}</strong>
                <p>{service.description}</p>
                <span class="card-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>
</section>

<style>
  .services-section { background: var(--slate-100); }

  .services-header {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 4rem;
    align-items: end;
  }
  .services-header .lead { margin: 0; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .service-card {
    position: relative;
    padding: clamp(1.7rem, 3vw, 2.35rem);
    display: flex;
    flex-direction: column;
    gap: .55rem;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .service-card:hover {
    border-color: var(--blue-600);
    box-shadow: 0 12px 40px rgba(23,105,224,.07);
  }

  .service-meta { display: flex; align-items: center; gap: .9rem; }
  .service-layer {
    color: var(--blue-600);
    font-weight: 900;
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .line { width: 44px; height: 1px; background: var(--slate-200); }

  .service-card h3 { margin: 1.2rem 0 0; font-size: clamp(1.15rem, 1.9vw, 1.5rem); line-height: 1.2; }
  .service-card h3 a { color: var(--navy-950); transition: color .2s ease; }
  .service-card h3 a:hover { color: var(--blue-600); }

  .description { margin: 0; max-width: 62ch; font-size: .94rem; }

  .outcome-wrap {
    margin-top: auto;
    padding-top: 1.3rem;
    border-top: 1px solid var(--slate-200);
  }
  .outcome-wrap > span {
    color: var(--slate-500);
    font-size: .67rem;
    font-weight: 850;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .outcome {
    margin: .4rem 0 0;
    color: var(--navy-900);
    font-weight: 750;
    line-height: 1.45;
    font-size: .92rem;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    margin-top: .6rem;
    color: var(--blue-600);
    font-size: .86rem;
    font-weight: 800;
    transition: gap .2s ease;
  }
  .service-link:hover { gap: .65rem; }

  /* Complementares */
  .complementary-block {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--slate-200);
  }
  .complementary-label {
    margin: 0 0 1.2rem;
    color: var(--slate-500);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .complementary-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: .75rem;
  }
  .complementary-card {
    display: flex;
    flex-direction: column;
    gap: .4rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-md);
    background: var(--white);
    transition: border-color .2s ease, transform .2s ease;
  }
  .complementary-card:hover { border-color: var(--slate-300); transform: translateY(-2px); }
  .complementary-card strong { display: block; color: var(--navy-950); font-size: .96rem; }
  .complementary-card p { margin: 0; color: var(--slate-700); font-size: .84rem; line-height: 1.5; }
  .card-arrow { color: var(--teal-500); font-weight: 900; margin-top: .3rem; font-size: .88rem; }

  @media (max-width: 820px) {
    .services-header { grid-template-columns: 1fr; gap: 1.4rem; }
  }
  @media (max-width: 760px) {
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
