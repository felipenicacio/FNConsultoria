---
import { services } from '../data/services';
---
<section id="servicos" class="section services-section">
  <div class="container">
    <div class="section-header services-header">
      <div>
        <p class="eyebrow">Serviços</p>
        <h2>Da avaliação do cenário atual à construção de capacidades sustentáveis.</h2>
      </div>
      <p class="lead">Serviços estruturados para apoiar decisões, organizar prioridades e desenvolver a Segurança da Informação como capacidade de gestão.</p>
    </div>
    <div class="services-grid">
      {services.map((service, index) => (
        <article class:list={["service-card", { featured: index === 0 }]}>
          <div class="service-meta">
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <span class="line" aria-hidden="true"></span>
          </div>
          <h3>{service.title}</h3>
          <p class="description">{service.description}</p>
          <div class="outcome-wrap">
            <span>Resultado esperado</span>
            <p class="outcome">{service.outcome}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section { background: var(--slate-100); }
  .services-header { display: grid; grid-template-columns: 1.05fr .95fr; gap: 4rem; align-items: end; }
  .services-header .lead { margin: 0; }
  .services-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; }
  .service-card { position: relative; min-height: 330px; padding: clamp(1.7rem, 3vw, 2.35rem); display: flex; flex-direction: column; border: 1px solid var(--slate-200); border-radius: var(--radius-lg); background: var(--white); }
  .service-card.featured { grid-column: span 2; min-height: 300px; background: var(--navy-950); border-color: var(--navy-950); box-shadow: var(--shadow-soft); }
  .service-meta { display: flex; align-items: center; gap: .9rem; }
  .number { color: var(--blue-600); font-weight: 900; font-size: .75rem; letter-spacing: .14em; }
  .line { width: 44px; height: 1px; background: var(--slate-200); }
  .featured .number { color: #5eead4; }
  .featured .line { background: rgba(255,255,255,.18); }
  h3 { margin: 2rem 0 .9rem; font-size: clamp(1.4rem, 2.2vw, 1.8rem); max-width: 26ch; }
  .featured h3 { color: white; }
  .description { max-width: 62ch; }
  .featured .description { color: #cbd5e1; }
  .outcome-wrap { margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--slate-200); }
  .outcome-wrap > span { color: var(--slate-500); font-size: .68rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .outcome { margin: .45rem 0 0; color: var(--navy-900); font-weight: 750; line-height: 1.45; }
  .featured .outcome-wrap { border-color: rgba(255,255,255,.14); }
  .featured .outcome-wrap > span { color: #7dd3fc; }
  .featured .outcome { color: white; }
  @media (max-width: 820px) { .services-header { grid-template-columns: 1fr; gap: 1.4rem; } }
  @media (max-width: 760px) { .services-grid { grid-template-columns: 1fr; } .service-card.featured { grid-column: auto; } }
</style>
