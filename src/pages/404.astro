---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Página não encontrada | FN Security"
  description="A página que você procura não existe ou foi movida."
  noindex={true}
>
  <Header />
  <main id="conteudo-principal" class="error-main">
    <div class="container error-content">
      <p class="eyebrow">404</p>
      <h1>Página não encontrada.</h1>
      <p class="lead">
        A página que você procura não existe ou foi movida.
        Verifique o endereço ou volte ao início.
      </p>
      <div class="error-actions">
        <a class="button button-primary" href="/">Voltar ao início</a>
        <a class="button-outline" href="/#servicos">Ver serviços</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .error-main {
    background: var(--navy-950);
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: 6rem 0;
  }
  .error-content { color: white; max-width: 52ch; }
  .error-content .eyebrow { color: #5eead4; }
  .error-content h1 { color: white; }
  .error-content .lead { color: #cbd5e1; }
  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    margin-top: 2rem;
  }
  .button-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: .82rem 1.28rem;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 999px;
    color: white;
    font-weight: 800;
    background: transparent;
    transition: border-color .2s ease;
  }
  .button-outline:hover { border-color: rgba(255,255,255,.55); }
</style>
